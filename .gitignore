# ==========================================
# AdEx Resonant Core — Optimized .gitignore
# ==========================================

# ------------------------------------------
# Python & Environment
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# ------------------------------------------
# KiCad 10 / EDA Temporary & Backup Files
# ------------------------------------------
hardware/.history/
*.kicad_prl
*.kicad_pcb-bak
*.sch-bak
*.kicad_pro.bak
*_autosave/
*.lck
*.tmp

# KiCad system symbol library copies (not project-specific)
hardware/symbols/Comparator.kicad_sym
hardware/symbols/Device.kicad_sym
hardware/symbols/Transistor_BJT.kicad_sym
hardware/symbols/Transistor_FET.kicad_sym

# ------------------------------------------
# SPICE Raw Artifacts & Transient Logs
# ------------------------------------------
*.raw
*.op.raw
*.log

# ------------------------------------------
# Hardware Exports — Production Packages
# Ignore zip archives, gerber subdirectory, and DRC reports
# (regenerated on each export run).
# BOM and CPL production metrics (bom_*.csv / cpl_*.csv)
# are PRESERVED as canonical source-tracked artifacts.
# ------------------------------------------
hardware/exports/*.zip
hardware/exports/gerber/
hardware/exports/drc_report.*

# ------------------------------------------
# Simulation Output (regenerated on each run)
# ------------------------------------------
simulations/results/*.csv
simulations/results/*.png

# ------------------------------------------
# IDEs & System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store