;; ──────────────────────────────────────────────
  ;;  NET DECLARATIONS & NET CLASS ASSIGNMENTS
  ;; ──────────────────────────────────────────────

  ;; Global power nets
  (net (name "+5V")      (net_class "Default"))
  (net (name "-5V")      (net_class "Default"))
  (net (name "GND")      (net_class "Default"))

  ;; VDD / VSS aliases
  (net (name "VDD")      (net_class "Default"))
  (net (name "VSS")      (net_class "Default"))

  ;; ANALOG_MEMBRANE — neuron membrane potential nets
  (net (name "V_m")      (net_class "ANALOG_MEMBRANE"))
  (net (name "V_tune")   (net_class "ANALOG_MEMBRANE"))
  (net (name "I_ext")    (net_class "ANALOG_MEMBRANE"))
  (net (name "V_TH")     (net_class "ANALOG_MEMBRANE"))

  ;; RESONANCE_LC — LC tank / bridge coupling nets
  (net (name "LC_MID")   (net_class "RESONANCE_LC"))
  (net (name "NODE_A")   (net_class "RESONANCE_LC"))
  (net (name "NODE_B")   (net_class "RESONANCE_LC"))

  ;; DIGITAL_SPIKE — spike / reset digital signals
  (net (name "SPIKE_OUT")(net_class "DIGITAL_SPIKE"))

  ;; ──────────────────────────────────────────────
  ;;  GLOBAL POWER WIRES — VDD / VSS / GND bus
  ;; ──────────────────────────────────────────────

  ;; VDD (+5V) horizontal distribution
  (wire (pts (xy 30 10) (xy 290 10))
    (stroke (width 0.254) (type solid) )
    (uuid "tpw0001-0001-4001-w001-000000000001")
  )

  ;; VSS (-5V) horizontal distribution
  (wire (pts (xy 30 20) (xy 290 20))
    (stroke (width 0.254) (type solid) )
    (uuid "tpw0002-0002-4002-w002-000000000002")
  )

  ;; GND horizontal distribution
  (wire (pts (xy 30 30) (xy 290 30))
    (stroke (width 0.254) (type solid) )
    (uuid "tpw0003-0003-4003-w003-000000000003")
  )

  ;; GND vertical spurs to sheet rows
  (wire (pts (xy 80 30) (xy 80 200))
